<ui:FluentWindow x:Class="Vendex.App.DevolucaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Devolução de mercadoria" Height="720" Width="1000"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Devolução de mercadoria" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cliente, venda de origem (opcional) e busca de produto -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cliente" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Content="+ Novo cliente" Appearance="Transparent" Padding="6,2"
                                   FontSize="12" Command="{Binding AlternarNovoClienteCommand}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Clientes}" DisplayMemberPath="Nome"
                              SelectedItem="{Binding ClienteSelecionado}" Margin="0,0,0,12" />

                    <StackPanel Visibility="{Binding MostrarNovoCliente, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,12">
                        <ui:TextBox Text="{Binding NovoClienteNome, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Nome do novo cliente" Margin="0,0,0,8" />
                        <ui:TextBox Text="{Binding NovoClienteTelefone, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Telefone (opcional)" Margin="0,0,0,8" />
                        <ui:Button Content="Cadastrar cliente" Command="{Binding AdicionarClienteRapidoCommand}"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Text="Venda de origem (opcional)" Margin="0,0,0,4" Foreground="#6B7280" FontSize="12" />
                    <ComboBox ItemsSource="{Binding VendasCliente}" SelectedItem="{Binding VendaSelecionada}" Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="Venda #" /><Run Text="{Binding Id, Mode=OneWay}" />
                                    <Run Text=" — " /><Run Text="{Binding DataHora, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}" />
                                    <Run Text=" — " /><Run Text="{Binding ValorTotal, Mode=OneWay, StringFormat='{}{0:C2}'}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Content="Carregar itens desta venda" Command="{Binding CarregarItensDaVendaCommand}"
                               IsEnabled="{Binding PodeCarregarItensDaVenda}" HorizontalAlignment="Left" Margin="0,0,0,20" />

                    <TextBlock Text="Buscar produto (nome ou código de barras)" Margin="0,0,0,6" Foreground="#6B7280" FontSize="12" />
                    <ui:TextBox FontSize="16" Padding="10" Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AdicionarPrimeiroResultadoCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <TextBlock Text="Quantidade" Margin="0,12,0,6" Foreground="#6B7280" FontSize="12" />
                    <ui:TextBox Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="10" />

                    <ListBox ItemsSource="{Binding ResultadosBusca}" Margin="0,12,0,0" BorderThickness="0" Background="Transparent"
                             MaxHeight="260">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F7FB" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.AdicionarProdutoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NomeExibicao}" FontWeight="Medium" Foreground="#1F2430" />
                                        <TextBlock Text="{Binding PrecoVenda, StringFormat='Preço: {0:C2}'}" Foreground="#6B7280" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Itens a devolver, motivo, estorno e confirmação -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,16">
                    <ListView ItemsSource="{Binding Itens}" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Produto" Width="260">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nome}" Foreground="#1F2430" Padding="0,6" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Quantidade" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Preço Unit." Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrecoUnitarioFormatado}" Foreground="#1F2430" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Subtotal" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SubtotalFormatado}" FontWeight="SemiBold" Foreground="#1F2430" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="Remover"
                                                       Command="{Binding DataContext.RemoverItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Motivo (opcional)" Margin="0,0,0,4" Foreground="#6B7280" FontSize="12" />
                        <ui:TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <CheckBox Content="Devolver valor em dinheiro (retira do caixa)" IsChecked="{Binding EstornarCaixa}" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Total a devolver" Foreground="#6B7280" FontSize="12" />
                                <TextBlock Text="{Binding TotalFormatado}" FontSize="22" FontWeight="Bold" Foreground="#1F2430" />
                            </StackPanel>

                            <ui:Button Grid.Column="1" Content="Cancelar (Esc)" Padding="16,10" Margin="0,0,12,0"
                                       Click="BtnCancelar_Click" />
                            <ui:Button Grid.Column="2" Content="Confirmar Devolução (Enter)" Appearance="Primary" Padding="16,10"
                                       IsDefault="True" IsEnabled="{Binding PodeConfirmar}"
                                       Command="{Binding ConfirmarCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding MensagemErro}" Foreground="#C4291E" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
