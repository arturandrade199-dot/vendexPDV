<UserControl x:Class="Vendex.App.Views.ContasReceberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmarRecebimentoCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelarRecebimentoCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cartões de resumo -->
        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,20">
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#F0413A">
                <StackPanel>
                    <TextBlock Text="Vencidos" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding VencidosFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#F0413A">
                <StackPanel>
                    <TextBlock Text="Vencem hoje" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding VencemHojeFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#F2A93B">
                <StackPanel>
                    <TextBlock Text="A vencer" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding AVencerFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#2FA35C">
                <StackPanel>
                    <TextBlock Text="Recebidos" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding RecebidosFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#3B82F6" Margin="0">
                <StackPanel>
                    <TextBlock Text="Total do período" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding TotalPeriodoFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de ações -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <ui:Button Content="+ Adicionar (Ctrl+N)" Appearance="Primary"
                           Command="{Binding AdicionarCommand}" Padding="18,8"
                           HorizontalAlignment="Left"
                           Visibility="{Binding PodeCriar, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!-- Busca e filtros -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,16">
                <ui:TextBox Width="320"
                            PlaceholderText="🔍 Buscar por descrição ou cliente"
                            Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                            ClearButtonEnabled="True" />
                <ComboBox Width="150" Margin="8,0,0,0"
                          ItemsSource="{Binding SituacoesDisponiveis}" SelectedItem="{Binding SituacaoSelecionada}" />
            </StackPanel>

            <!-- Tabela -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                <ListView ItemsSource="{Binding Contas}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Vencimento" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Vencimento}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Descrição" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Descricao}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Cliente" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClienteNome}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Total R$" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalFormatado}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Situação" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding SituacaoFundo}" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding SituacaoTexto}" FontWeight="Medium">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding SituacaoCor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ações" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="Marcar como recebido"
                                                   Command="{Binding DataContext.MarcarComoRecebidoCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Visibility>
                                                <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                                                    <Binding Path="PodeMarcarComoRecebido" />
                                                    <Binding Path="DataContext.PodeEditar" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                                </MultiBinding>
                                            </ui:Button.Visibility>
                                        </ui:Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- Confirmação de recebimento: escolhe a forma de pagamento antes de marcar como recebido -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#66000000"
              Visibility="{Binding MostrarConfirmacaoRecebimento, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Marcar como recebido" FontWeight="SemiBold" FontSize="16" Foreground="#1F2430" Margin="0,0,0,4" />
                    <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,16">
                        <Run Text="{Binding ContaParaReceber.ClienteNome, Mode=OneWay}" />
                        <Run Text=" — " /><Run Text="{Binding ContaParaReceber.TotalFormatado, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="Forma de pagamento" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding FormasPagamentoDisponiveis}" SelectedItem="{Binding FormaPagamentoSelecionada}"
                              Padding="8" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancelar (Esc)" Margin="0,0,8,0" Command="{Binding CancelarRecebimentoCommand}" />
                        <ui:Button Content="Confirmar (Enter)" Appearance="Primary" Command="{Binding ConfirmarRecebimentoCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
