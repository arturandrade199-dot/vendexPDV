<UserControl x:Class="Vendex.App.Views.ContasPagarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cartões de resumo -->
        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,20">
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#F0413A">
                <StackPanel>
                    <TextBlock Text="Vencidos" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding VencidosFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#F0413A">
                <StackPanel>
                    <TextBlock Text="Vencem hoje" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding VencemHojeFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#F2A93B">
                <StackPanel>
                    <TextBlock Text="A vencer" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding AVencerFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#2FA35C">
                <StackPanel>
                    <TextBlock Text="Pagos" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding PagosFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#3B82F6" Margin="0">
                <StackPanel>
                    <TextBlock Text="Total do período" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding TotalPeriodoFormatado}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de ações -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="+ Adicionar" Appearance="Primary"
                           Command="{Binding AdicionarCommand}" Padding="18,8"
                           Visibility="{Binding PodeCriar, Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Importar" IsEnabled="False" ToolTip="Em breve" Margin="0,0,8,0" />
                    <ui:Button Content="Exportar" IsEnabled="False" ToolTip="Em breve" Margin="0,0,8,0" />
                    <ui:Button Content="Imprimir" IsEnabled="False" ToolTip="Em breve" />
                </StackPanel>
            </Grid>

            <!-- Tabela -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                <ListView ItemsSource="{Binding Contas}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Vencimento" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Vencimento}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Descrição" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Descricao}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Fornecedor" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FornecedorNome}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Total R$" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalFormatado}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Situação" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding SituacaoFundo}" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding SituacaoTexto}" FontWeight="Medium">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding SituacaoCor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ações" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="Marcar como pago"
                                                   Command="{Binding DataContext.MarcarComoPagoCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Visibility>
                                                <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                                                    <Binding Path="PodeMarcarComoPago" />
                                                    <Binding Path="DataContext.PodeEditar" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                                </MultiBinding>
                                            </ui:Button.Visibility>
                                        </ui:Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- Confirmação de pagamento: escolhe a forma de pagamento antes de marcar como pago -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#66000000"
              Visibility="{Binding MostrarConfirmacaoPagamento, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Marcar como pago" FontWeight="SemiBold" FontSize="16" Foreground="#1F2430" Margin="0,0,0,4" />
                    <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,16">
                        <Run Text="{Binding ContaParaPagar.FornecedorNome, Mode=OneWay}" />
                        <Run Text=" — " /><Run Text="{Binding ContaParaPagar.TotalFormatado, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="Forma de pagamento" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding FormasPagamentoDisponiveis}" SelectedItem="{Binding FormaPagamentoSelecionada}"
                              Padding="8" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancelar" Margin="0,0,8,0" Command="{Binding CancelarPagamentoCommand}" />
                        <ui:Button Content="Confirmar" Appearance="Primary" Command="{Binding ConfirmarPagamentoCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
