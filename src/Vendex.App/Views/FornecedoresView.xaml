<UserControl x:Class="Vendex.App.Views.FornecedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cartão de resumo -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource CartaoResumo}" BorderBrush="#5B4FE9">
                <StackPanel>
                    <TextBlock Text="Total de fornecedores" Style="{StaticResource RotuloResumo}" />
                    <TextBlock Text="{Binding TotalFornecedores}" Style="{StaticResource ValorResumo}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de ações -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:Button Content="+ Adicionar (Ctrl+N)" Appearance="Primary"
                               Command="{Binding AdicionarCommand}" Padding="18,8" Margin="0,0,8,0"
                               Visibility="{Binding PodeCriar, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ui:Button x:Name="BtnAtalhos" Content="⌨ Atalhos" Appearance="Transparent" Padding="10,8"
                               Click="BtnAtalhos_Click" />
                    <Popup x:Name="PopupAtalhos" PlacementTarget="{Binding ElementName=BtnAtalhos}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="16" Width="300" Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Atalhos de teclado" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                <TextBlock Text="Ctrl+N — Adicionar fornecedor" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <TextBlock Text="Selecione uma linha e pressione Enter — Editar" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <TextBlock Text="Selecione uma linha e pressione Delete — Remover" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- Tabela -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                <ListView ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding ItemSelecionado}"
                          BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nome" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nome}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Telefone" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Telefone}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Documento" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Documento}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Endereço" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Endereco}" Foreground="#1F2430" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Cadastro" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataCadastroFormatada}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ações" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Editar" Margin="0,0,8,0"
                                                       Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ui:Button Content="Remover"
                                                       Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding DataContext.PodeExcluir, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
