<ui:FluentWindow x:Class="Vendex.App.NovoLoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Novo lote" Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Novo lote" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Produto" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ProdutoSelecionado.NomeExibicao, TargetNullValue='Nenhum produto selecionado'}"
                           VerticalAlignment="Center" Foreground="#1F2430" />
                <ui:Button Grid.Column="1" Content="🔍 Selecionar" Margin="8,0,0,0" Padding="10,6"
                           Command="{Binding AbrirSelecaoProdutoCommand}" />
            </Grid>

            <TextBlock Text="Data de fabricação/entrada" Margin="0,0,0,4" />
            <DatePicker SelectedDate="{Binding DataFabricacao}" Margin="0,0,0,12" />

            <TextBlock Text="Data de validade" Margin="0,0,0,4" />
            <DatePicker SelectedDate="{Binding DataValidade}" Margin="0,0,0,12" />

            <TextBlock Text="Quantidade" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

            <TextBlock Text="Observações" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                        AcceptsReturn="True" TextWrapping="Wrap" Height="70" />

            <TextBlock Text="{Binding MensagemErro}" Foreground="#C4291E" Margin="0,0,0,12" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar (Esc)" Margin="0,0,8,0" Click="BtnCancelar_Click" />
                <ui:Button Content="Salvar (Enter)" Appearance="Primary" Command="{Binding ConfirmarCommand}"
                           IsDefault="True" IsEnabled="{Binding PodeConfirmar}" Padding="24,8" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
