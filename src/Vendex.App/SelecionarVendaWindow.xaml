<ui:FluentWindow x:Class="Vendex.App.SelecionarVendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Selecionar venda" Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Selecionar venda" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Período (padrão: hoje) -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="De" Margin="0,0,0,4" Foreground="#6B7280" FontSize="12" />
                    <DatePicker SelectedDate="{Binding DataInicio}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Até" Margin="0,0,0,4" Foreground="#6B7280" FontSize="12" />
                    <DatePicker SelectedDate="{Binding DataFim}" />
                </StackPanel>
                <ui:Button Grid.Column="4" Content="Buscar" VerticalAlignment="Bottom" Padding="14,7"
                           Command="{Binding BuscarCommand}" IsEnabled="{Binding PodeBuscar}" />
            </Grid>

            <ui:TextBox Grid.Row="1" Margin="0,0,0,12"
                        PlaceholderText="🔍 Buscar por número ou cliente"
                        Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                        ClearButtonEnabled="True" />

            <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,16">
                <ListView ItemsSource="{Binding Resultados}" SelectedItem="{Binding VendaSelecionada}"
                          BorderThickness="0" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Número" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}" Foreground="#1F2430" Padding="0,6" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Data" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataHora, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Cliente" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Cliente.Nome}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Total" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ValorTotal, StringFormat='{}{0:C2}'}" Foreground="#1F2430" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar (Esc)" Margin="0,0,8,0" Click="BtnCancelar_Click" />
                <ui:Button Content="OK" Appearance="Primary" Command="{Binding ConfirmarCommand}"
                           IsEnabled="{Binding PodeConfirmar}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
