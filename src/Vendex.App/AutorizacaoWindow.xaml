<ui:FluentWindow x:Class="Vendex.App.AutorizacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Autorização necessária" Height="420" Width="380"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Autorização necessária" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Foreground="#1F2430"
                       FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Text="Peça para um usuário com permissão digitar os dados abaixo para liberar."
                       TextWrapping="Wrap" Foreground="#6B7280" Margin="0,0,0,16" />

            <TextBlock Text="Login" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

            <TextBlock Text="Senha" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordBoxSenha" Margin="0,0,0,12"
                         PasswordChanged="PasswordBoxSenha_PasswordChanged">
                <PasswordBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ConfirmarCommand}" />
                </PasswordBox.InputBindings>
            </PasswordBox>

            <TextBlock Text="{Binding MensagemErro}" Foreground="#C4291E" Margin="0,0,0,12" TextWrapping="Wrap" />

            <ui:Button Content="Autorizar" Appearance="Primary" Command="{Binding ConfirmarCommand}"
                       HorizontalAlignment="Stretch" Padding="0,10" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
